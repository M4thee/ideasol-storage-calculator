import Link from "next/link";
import { blogArticles } from "@/lib/blog/index";

export const metadata = {
  title: "Baza wiedzy o fotowoltaice i magazynach energii | IdeaSol",
  description:
    "Praktyczne poradniki o magazynach energii, fotowoltaice, net-billingu, taryfach dynamicznych, autokonsumpcji, HEMS/EMS i zasilaniu awaryjnym.",
};

function formatDate(date: string) {
  return new Intl.DateTimeFormat("pl-PL", {
    day: "2-digit",
    month: "long",
    year: "numeric",
  }).format(new Date(date));
}

export default function BlogPage() {
  const sortedArticles = [...blogArticles].sort(
    (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime()
  );

  const featuredArticle = sortedArticles[0];
  const remainingArticles = sortedArticles.slice(1);

  return (
    <main className="min-h-screen bg-[#07111f] text-white">
      <section className="relative overflow-hidden border-b border-white/10 px-4 py-12 sm:px-6 lg:px-8">
        <div className="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(34,211,238,0.18),transparent_35%),radial-gradient(circle_at_top_right,rgba(190,255,103,0.13),transparent_30%)]" />
        <div className="relative mx-auto max-w-6xl">
          <Link
            href="/"
            className="inline-flex rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-cyan-100 transition hover:bg-white/10"
          >
            ← Wróć do kalkulatora
          </Link>

          <div className="mt-12 grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
            <div>
              <p className="text-sm font-semibold uppercase tracking-[0.22em] text-cyan-300/80">
                Baza wiedzy IdeaSol
              </p>
              <h1 className="mt-4 text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl">
                Fotowoltaika, magazyny energii i uczciwa matematyka
              </h1>
              <p className="mt-6 max-w-2xl text-base leading-8 text-slate-300 sm:text-lg">
                Bez marketingowej ściemy, bez presji i bez obietnic zwrotu w dwa lata. Konkretne
                poradniki o tym, kiedy magazyn energii ma sens, jak działa net-billing, jak dobrać
                pojemność i kiedy warto rozważyć HEMS, EMS albo backup.
              </p>

              <div className="mt-7 flex flex-wrap gap-3 text-sm text-slate-200">
                <span className="rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-2">
                  Rzetelne obliczenia
                </span>
                <span className="rounded-full border border-lime-300/20 bg-lime-300/10 px-4 py-2">
                  Uczciwe OZE
                </span>
                <span className="rounded-full border border-white/10 bg-white/5 px-4 py-2">
                  Bez clickbaitu
                </span>
              </div>
            </div>

            <div className="rounded-3xl border border-white/10 bg-white/[0.04] p-6 shadow-2xl shadow-cyan-950/30">
              <p className="text-sm font-bold uppercase tracking-[0.18em] text-lime-200">
                Po co ta baza wiedzy?
              </p>
              <p className="mt-4 text-sm leading-7 text-slate-300">
                Bo większość decyzji o OZE nie powinna zaczynać się od rozmowy ze sprzedawcą, tylko
                od zrozumienia własnego zużycia prądu, taryfy i realnych kosztów inwestycji.
              </p>
              <Link
                href="/#calculator"
                className="mt-6 inline-flex rounded-full bg-lime-300 px-5 py-3 text-sm font-black text-slate-950 transition hover:bg-lime-200"
              >
                Przelicz swój dom →
              </Link>
            </div>
          </div>
        </div>
      </section>

      <section className="px-4 py-12 sm:px-6 lg:px-8">
        <div className="mx-auto max-w-6xl">
          {blogArticles.length === 0 ? (
            <div className="rounded-3xl border border-dashed border-white/15 bg-white/[0.03] p-8 text-slate-300">
              <h2 className="text-2xl font-bold text-white">Artykuły są w przygotowaniu</h2>
              <p className="mt-3 max-w-2xl leading-7">
                W tym miejscu pojawią się poradniki SEO dotyczące fotowoltaiki, magazynów energii,
                net-billingu, taryf energetycznych, HEMS/EMS i zasilania awaryjnego.
              </p>
            </div>
          ) : (
            <>
              {featuredArticle ? (
                <Link
                  href={`/blog/${featuredArticle.slug}`}
                  className="group grid overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.04] transition hover:-translate-y-1 hover:border-cyan-300/40 hover:bg-white/[0.07] lg:grid-cols-[0.9fr_1.1fr]"
                >
                  <div className="relative min-h-[260px] bg-gradient-to-br from-cyan-500/20 via-slate-900 to-lime-300/10 p-7">
                    <div className="absolute inset-0 opacity-30 [background-image:linear-gradient(rgba(255,255,255,.08)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.08)_1px,transparent_1px)] [background-size:34px_34px]" />
                    <div className="relative flex h-full flex-col justify-between">
                      <span className="w-fit rounded-full bg-lime-300 px-4 py-2 text-xs font-black uppercase tracking-[0.16em] text-slate-950">
                        Polecany artykuł
                      </span>
                      <div>
                        <p className="text-sm font-semibold text-cyan-100">IdeaSol Blog</p>
                        <p className="mt-2 text-3xl font-black leading-none text-white">
                          Magazyn energii
                        </p>
                      </div>
                    </div>
                  </div>

                  <div className="p-7 sm:p-9">
                    <div className="flex flex-wrap items-center gap-3 text-xs text-slate-400">
                      <span className="rounded-full bg-cyan-300/10 px-3 py-1 font-bold text-cyan-200">
                        {featuredArticle.category}
                      </span>
                      <span>{formatDate(featuredArticle.publishedAt)}</span>
                      <span>•</span>
                      <span>{featuredArticle.readingTime}</span>
                    </div>

                    <h2 className="mt-5 text-2xl font-black leading-tight text-white group-hover:text-cyan-100 sm:text-3xl">
                      {featuredArticle.title}
                    </h2>
                    <p className="mt-4 line-clamp-4 text-sm leading-7 text-slate-300 sm:text-base">
                      {featuredArticle.description}
                    </p>

                    <div className="mt-7 text-sm font-black text-lime-200">
                      Czytaj analizę →
                    </div>
                  </div>
                </Link>
              ) : null}

              {remainingArticles.length > 0 ? (
                <div className="mt-12">
                  <div className="flex items-end justify-between gap-4">
                    <div>
                      <p className="text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300/80">
                        Najnowsze poradniki
                      </p>
                      <h2 className="mt-2 text-3xl font-black">Czytaj dalej</h2>
                    </div>
                  </div>

                  <div className="mt-7 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                    {remainingArticles.map((article) => (
                      <Link
                        key={article.slug}
                        href={`/blog/${article.slug}`}
                        className="group rounded-3xl border border-white/10 bg-white/[0.04] p-6 transition hover:-translate-y-1 hover:border-cyan-300/40 hover:bg-white/[0.07]"
                      >
                        <div className="flex items-center justify-between gap-3 text-xs text-slate-400">
                          <span className="rounded-full bg-cyan-300/10 px-3 py-1 font-bold text-cyan-200">
                            {article.category}
                          </span>
                          <span>{article.readingTime}</span>
                        </div>
                        <p className="mt-3 text-xs text-slate-500">
                          {formatDate(article.publishedAt)}
                        </p>

                        <h3 className="mt-5 text-xl font-black leading-tight text-white group-hover:text-cyan-100">
                          {article.title}
                        </h3>
                        <p className="mt-3 line-clamp-4 text-sm leading-7 text-slate-300">
                          {article.description}
                        </p>

                        <div className="mt-6 text-sm font-bold text-lime-200">
                          Czytaj artykuł →
                        </div>
                      </Link>
                    ))}
                  </div>
                </div>
              ) : null}
            </>
          )}
        </div>
      </section>
    </main>
  );
}